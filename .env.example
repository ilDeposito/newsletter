# Public hostname handled by Caddy (without https://)
LISTMONK_DOMAIN=news.example.com

# Listmonk administrator. Use a long, unique password.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=replace-with-a-long-unique-password

# PostgreSQL credentials. Use a long, unique password.
POSTGRES_DB=listmonk
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=replace-with-a-long-unique-password
